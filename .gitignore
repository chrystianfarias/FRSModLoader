# Mods and native plugins are local: the repository is the platform, not a
# collection of what happens to be installed on one machine. The examples that
# are meant to be read live in examples/.
mods/
plugins/

# The UI's font (Helvetica Neue) is licensed, not ours to redistribute: it is
# installed locally beside nfsu2.css.
ui/fonts/

